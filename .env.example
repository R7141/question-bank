# ========== 应用密钥 ==========
# 用于 JWT 签名，生产环境必须替换为随机字符串
# 生成命令: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# ========== 数据库 ==========
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=question_bank
MYSQL_USER=question_bank
MYSQL_PASSWORD=change-me

# 后端连接串 (docker-compose 环境使用 mysql 主机名)
DB_URL=mysql+aiomysql://question_bank:change-me@mysql:3306/question_bank

# ========== ChromaDB ==========
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
# docker-compose 部署使用独立 ChromaDB 服务，保持 http；留空即为默认 http
CHROMADB_MODE=http

# ========== 镜像版本 ==========
# 使用预构建镜像时的 tag，可选 latest / 具体版本号(如 1.2.0) / main-<commit-sha>
# 详见 https://github.com/gygy-open/question-bank/pkgs/container/question-bank-backend
IMAGE_TAG=latest

# ========== 其它 ==========
LOG_LEVEL=INFO

# ========== MinerU PDF 转换 ==========
# MinerU 4.x V1 API 地址；留空则 PDF 导入不可用。
# 独立容器接入 QB 默认网络：docker network connect question-bank_default qb-mineru-standalone
# 然后填写 http://qb-mineru-standalone:8000
# 若 MinerU 作为 QB Compose 服务运行，则填写 http://qb-mineru:8000
MINERU_API_URL=
# 若 MinerU 启动时配置了 --api-key，在这里填写
MINERU_API_KEY=
# 解析档位：flash / basic / standard / advanced（CPU 推荐 standard，basic 更快）
MINERU_TIER=standard
# 智能导入同步等待上限（秒）
MINERU_TIMEOUT_SECONDS=600
# 批量导入 Worker 等待上限（秒）
MINERU_WORKER_TIMEOUT_SECONDS=1800
